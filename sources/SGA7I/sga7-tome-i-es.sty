\ifdefined\SGAOriginalMode
  \newcommand{\sisi}[2]{#1}
  \def\SGASevenBranchName{original diplomática}
  \def\SGASevenPdfSuffix{original}
\else
  \newcommand{\sisi}[2]{#2}
  \def\SGASevenBranchName{corriente corregida}
  \def\SGASevenPdfSuffix{current}
\fi

